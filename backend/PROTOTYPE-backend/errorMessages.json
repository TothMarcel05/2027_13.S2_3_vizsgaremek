      },
      "404": {
        "Code": "NINCS_VEGPONT",
        "Message": "Nincs ilyen végpont: {method} {path}"
      },
      "405": {
        "Code": "NEM_ENGEDELYEZETT_METODUS",
        "Message": "A(z) {method} metódus nem támogatott ezen az útvonalon: {path}"
      },
      "409": {
        "Code": "UTKOZES",
        "Message": "Az erőforrás állapota ütközik a kért művelettel."
      },
      "429": {
